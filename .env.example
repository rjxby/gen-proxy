# Public API keys accepted by gen-proxy
ApiKeys__Keys__0=replace-with-public-api-key

# llama-runtime generation backend
GenerationRuntime__Address=https://localhost:50051
GenerationRuntime__ApiKey=replace-with-generation-runtime-key

# llama-runtime prompt-reduction backend
PromptReducerRuntime__Address=https://localhost:50052
PromptReducerRuntime__ApiKey=replace-with-prompt-reducer-runtime-key

# optional prompt-reduction behavior
PromptReduction__UsePromptReducerRuntime=true

# Optional ASP.NET Core environment
ASPNETCORE_ENVIRONMENT=Development
