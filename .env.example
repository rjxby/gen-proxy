# Public API keys accepted by gen-proxy
ApiKeys__Keys__0=replace-with-public-api-key

# llama-runtime generation backend
GenerationRuntime__Address=https://localhost:50051
GenerationRuntime__ApiKey=replace-with-generation-runtime-key
GenerationRuntime__Timeouts__EstimateTokens=00:00:10
GenerationRuntime__Timeouts__GetCapabilities=00:00:10
GenerationRuntime__Timeouts__Generate=00:02:00

# llama-runtime prompt-reduction backend
PromptReducerRuntime__Enabled=true
PromptReducerRuntime__Address=https://localhost:50052
PromptReducerRuntime__ApiKey=replace-with-prompt-reducer-runtime-key
PromptReducerRuntime__Timeouts__EstimateTokens=00:00:10
PromptReducerRuntime__Timeouts__GetCapabilities=00:00:10
PromptReducerRuntime__Timeouts__Generate=00:02:00

# Total time for a Responses request, including all runtime calls and reduction
ResponsesTimeout__Timeout=00:03:00

# required for make stack-run, make smoke, and make smoke-budget
MAIN_MODEL_PATH=/absolute/path/to/main-model.gguf
MAIN_MODEL_ID=main-local-model
SUMMARIZER_MODEL_PATH=/absolute/path/to/summarizer-model.gguf
SUMMARIZER_MODEL_ID=summarizer-local-model

# optional debug-only body logging; logs prompts and completions verbatim
ResponsesLogging__LogBodies=false

# Optional ASP.NET Core environment
ASPNETCORE_ENVIRONMENT=Development
